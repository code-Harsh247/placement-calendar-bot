{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placement-calendar-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Poll Naarad every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "placement-bot",
      // Replace with the id printed by `npx wrangler d1 create placement-bot`.
      "database_id": "1709d9d0-ad83-4175-9c25-16057f5946d5",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI, which reads the notices.
  "ai": { "binding": "AI" },

  "vars": {
    "NAARAD_URL": "https://naarad.metakgp.org",
    // The Naarad topic you're subscribed to. It carries every MFTP notice; non-PLACEMENT ones are skipped.
    "TOPIC": "kgp-mftp",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MAX_NOTICES_PER_RUN": "10",
    // "true" = log calendar actions without writing anything. Flip to "false" once a dry run looks right.
    "DRY_RUN": "false"
  }

  // Secrets (set with `npx wrangler secret put <NAME>`):
  // NAARAD_USER, NAARAD_PASS, GOOGLE_SA_EMAIL, GOOGLE_SA_KEY,
  // CALENDAR_ID, ALERT_TOPIC, RUN_TOKEN
}
