{
  "name": "placement-calendar-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "eval": "tsx scripts/eval.ts",
    "eval:live": "tsx scripts/eval.ts live",
    "db:migrate": "wrangler d1 migrations apply placement-bot --remote",
    "db:migrate:local": "wrangler d1 migrations apply placement-bot --local",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
